{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dokploy": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dokploy/mcp"
      ],
      "env": {
        "DOKPLOY_URL": "${DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "${DOKPLOY_API_KEY}"
      }
    }
  }
}